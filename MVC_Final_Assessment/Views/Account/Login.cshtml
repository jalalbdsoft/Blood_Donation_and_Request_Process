@using MVC_Final_Assessment.Models
@model LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout_for_Register_Login.cshtml";
    ViewBag.Title = "Log in";
}

<style>
    body {
        background: #f8f9fa;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-container {
        width: 100%;
        max-width: 1000px;
    }

    .card {
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border: 1px solid #dee2e6;
        background: white;
    }

    .card-header {
        padding: 1.5rem;
        font-weight: 600;
        font-size: 1.5rem;
        background: white !important;
        color: #000 !important;
        border-bottom: 1px solid #dee2e6;
    }

    .card-body {
        padding: 2rem;
    }

    .border-left {
        border-left: 1px solid #dee2e6 !important;
    }

    .btn-primary {
        background: #007bff;
        border: 1px solid #007bff;
        padding: 10px 20px;
        font-weight: 500;
        transition: all 0.3s;
        color: white;
    }

        .btn-primary:hover {
            background: #0056b3;
            border-color: #0056b3;
            transform: translateY(-1px);
        }

    .form-control {
        border-radius: 6px;
        padding: 12px 15px;
        border: 1px solid #ced4da;
        transition: all 0.3s;
        color: #000;
    }

        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            color: #000;
        }

    .form-group label {
        color: #000;
        font-weight: 500;
    }

    .credential-item {
        margin-bottom: 15px;
    }

    .input-group-sm .form-control {
        font-size: 0.875rem;
        padding: 8px 12px;
        color: #000;
    }

    .btn-outline-info {
        border-color: #6c757d;
        color: #6c757d;
        transition: all 0.3s;
    }

        .btn-outline-info:hover {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }

    .bg-info {
        background: #6c757d !important;
        border-color: #6c757d !important;
    }

    .border-info {
        border-color: #dee2e6 !important;
    }

    h4.text-muted {
        color: #6c757d !important;
        font-weight: 400;
    }

    .text-primary {
        color: #007bff !important;
        font-weight: 500;
    }

    .text-dark {
        color: #000 !important;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

    h2, h4, h6, strong {
        color: #000;
    }

    @@media (max-width: 768px) {
        .border-left {
            border-left: none !important;
            border-top: 1px solid #dee2e6 !important;
            padding-top: 1.5rem;
            margin-top: 1.5rem;
        }

        .card-body {
            padding: 1.5rem;
        }
    }
</style>

<div class="login-container">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h2 class="card-title mb-0">@ViewBag.Title</h2>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <section id="loginForm">
                        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                        {
                            @Html.AntiForgeryToken()
                            <h4 class="text-muted mb-4">Use a local account to log in.</h4>
                            <hr />
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-group row">
                                @Html.LabelFor(m => m.Email, new { @class = "col-md-3 col-form-label" })
                                <div class="col-md-9">
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter your email" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(m => m.Password, new { @class = "col-md-3 col-form-label" })
                                <div class="col-md-9">
                                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password" })
                                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-offset-3 col-md-9">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                                        @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-offset-3 col-md-9">
                                    <input type="submit" value="Log in" class="btn btn-primary btn-block" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-offset-3 col-md-9">
                                    <p class="mb-0">
                                        @Html.ActionLink("Register as a new user", "Register", null, new { @class = "text-primary" })
                                    </p>
                                </div>
                            </div>
                        }
                    </section>
                </div>

                <div class="col-md-4 border-left">
                    <section id="socialLoginForm">
                        @Html.Partial("_ExternalLoginsListPartial", new ExternalLoginListViewModel { ReturnUrl = ViewBag.ReturnUrl })

                        <!-- Default Credentials Card -->
                        <div class="mt-4">
                            <div class="card border-info">
                                <div class="card-header bg-info text-white py-2">
                                    <h6 class="mb-0"><i class="fas fa-key mr-2"></i>Demo Credentials</h6>
                                </div>
                                <div class="card-body p-3">
                                    <small class="text-muted d-block mb-2">Use these credentials for testing:</small>
                                    <div class="credential-item">
                                        <strong class="d-block text-dark">Email:</strong>
                                        <div class="input-group input-group-sm mb-2">
                                            <input type="text" class="form-control form-control-sm" value="jalal14uddin@gmail.com" id="demoEmail" readonly>
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary btn-sm" type="button" onclick="copyToClipboard('demoEmail')">
                                                    <i class="fas fa-copy"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="credential-item">
                                        <strong class="d-block text-dark">Password:</strong>
                                        <div class="input-group input-group-sm">
                                            <input type="password" class="form-control form-control-sm" value="123@Jalal" id="demoPassword" readonly>
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary btn-sm" type="button" onclick="copyToClipboard('demoPassword')">
                                                    <i class="fas fa-copy"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <button type="button" class="btn btn-outline-info btn-sm btn-block" onclick="fillDemoCredentials()">
                                            <i class="fas fa-magic mr-1"></i> Auto Fill
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        function copyToClipboard(elementId) {
            var copyText = document.getElementById(elementId);
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            document.execCommand("copy");

            // Show feedback
            var btn = event.target.closest('button');
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i>';
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success');

            setTimeout(function () {
                btn.innerHTML = originalHtml;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
            }, 1000);
        }

        function fillDemoCredentials() {
            document.getElementById('Email').value = 'jalal14uddin@gmail.com';
            document.getElementById('Password').value = '123@Jalal';

            // Show success message
            var btn = event.target;
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check mr-1"></i> Filled!';
            btn.classList.remove('btn-outline-info');
            btn.classList.add('btn-success');

            setTimeout(function () {
                btn.innerHTML = originalHtml;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-info');
            }, 2000);
        }
    </script>
}